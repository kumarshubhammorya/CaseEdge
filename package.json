{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:staging": "vite --mode staging --port=3000 --host=0.0.0.0",
    "dev:production": "vite --mode production --port=3000 --host=0.0.0.0",
    "start": "tsx server.ts",
    "start:staging": "APP_ENV=staging tsx server.ts",
    "start:production": "APP_ENV=production tsx server.ts",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@sentry/react": "^10.53.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-http-proxy": "^2.1.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.13.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.3",
    "motion": "^12.23.24",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "vite": "^6.2.0"
  },
  "overrides": {
    "node-domexception": "npm:domexception@^4.0.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/express-http-proxy": "^1.6.7",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.7"
  }
}
