rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'kumarshubhammorya@gmail.com'; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidCaseFile(data) {
      return data.keys().hasAll(['ownerId', 'name', 'extractedText']) 
        && data.ownerId == request.auth.uid
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.extractedText is string && data.extractedText.size() <= 500000;
    }

    function isValidPublicCase(data) {
      return data.keys().hasAll(['ownerId', 'ownerName', 'title', 'description', 'industry', 'difficulty', 'extractedText']) 
        && data.ownerId == request.auth.uid
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.ownerName is string && data.ownerName.size() <= 200
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1000
        && data.industry is string && data.industry.size() <= 100
        && data.difficulty is string && data.difficulty.size() <= 50
        && data.extractedText is string && data.extractedText.size() <= 500000;
    }

    match /cases/{caseId} {
      allow read, list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() 
        && isValidId(caseId) 
        && isValidCaseFile(incoming()) 
        && incoming().keys().size() >= 3;
      allow update: if isSignedIn() 
        && isValidCaseFile(incoming()) 
        && (incoming().ownerId == existing().ownerId || isAdmin());
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /public_cases/{caseId} {
      allow read, list: if true;
      allow create: if isSignedIn()
        && isValidId(caseId)
        && isValidPublicCase(incoming())
        && incoming().keys().size() >= 7;
      allow update: if false;
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (userId == request.auth.uid || isAdmin());
    }

    match /case_analytics/{analyticsId} {
      allow read: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
