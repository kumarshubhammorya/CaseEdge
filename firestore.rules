rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidCaseFile(data) {
      return data.keys().hasAll(['ownerId', 'name', 'extractedText']) 
        && data.ownerId == request.auth.uid
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.extractedText is string && data.extractedText.size() <= 500000;
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      // List
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(caseId) 
        && isValidCaseFile(incoming()) 
        && incoming().keys().size() >= 3;
      allow update: if isSignedIn() 
        && isValidCaseFile(incoming()) 
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
