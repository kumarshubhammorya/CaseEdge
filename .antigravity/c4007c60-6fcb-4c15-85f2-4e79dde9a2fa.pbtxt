    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n\n@theme {\n  --animate-shimmer: shimmer 2s infinite linear;\n  @keyframes shimmer {\n    from {\n      transform: translateX(-100%);\n    }\n    to {\n      transform: translateX(100%);\n    }\n  }\n}\n\n.custom-scrollbar::-webkit-scrollbar {\n  width: 6px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: rgba(15, 23, 42, 0.5); /* slate-900 */\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: rgba(51, 65, 85, 0.5); /* slate-700 */\n  border-radius: 10px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: rgba(71, 85, 105, 0.8); /* slate-600 */\n}"
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Syne:wght@400;500;600;700;800&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --color-brand-cyan: #00d4ff;\n  --color-brand-cyan-hover: #00b8e6;\n  --color-brand-gold: #c9a84c;\n  --color-brand-charcoal: #111318;\n  --color-brand-charcoal-light: #161920;\n  \n  --font-heading: \'Syne\', sans-serif;\n  --font-mono: \'DM Mono\', monospace;\n}\n\nbody {\n  background-color: var(--color-brand-charcoal);\n  color: white;\n  font-family: \'Syne\', sans-serif;\n}\n\n.bg-grid-pattern {\n  background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);\n  background-size: 24px 24px;\n}\n\n.war-card {\n  background-color: rgba(22, 25, 32, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 0.125rem; /* rounded-sm */\n  transition: all 0.2s ease-out;\n  backdrop-filter: blur(8px);\n}\n\n.war-card:hover {\n  box-shadow: inset 0 0 20px rgba(0, 212, 255, 0.05), inset 0 0 10px rgba(255, 255, 255, 0.02);\n  border-color: rgba(255, 255, 255, 0.15);\n}\n\n.slide-in-left {\n  animation: slideInLeft 150ms ease-out forwards;\n}\n\n@keyframes slideInLeft {\n  from {\n    opacity: 0;\n    transform: translateX(-20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n/* Custom scrollbar to match the sharp aesthetic */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: var(--color-brand-charcoal);\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 0;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-brand-cyan);\n}\n"
    }
    instruction: "Update global CSS with new typography, theme colors, background grid, and styling utilities for the war room redesign."
  }
}
